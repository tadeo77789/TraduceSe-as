# ─────────────────────────────────────────────
# DEPENDENCIAS — nunca se suben a GitHub
# ─────────────────────────────────────────────
# npm instala todos los paquetes localmente al correr "npm install".
# Subir node_modules sería subir miles de archivos innecesarios
# (puede pesar más de 500 MB). Cualquier persona que clone el repo
# solo necesita correr "npm install" para regenerarlos.
node_modules/

# ─────────────────────────────────────────────
# EXPO — archivos generados automáticamente
# ─────────────────────────────────────────────
# Expo genera esta carpeta al iniciar el servidor de desarrollo.
# Contiene caché y configuración local de la máquina, no del proyecto.
.expo/
dist/
web-build/

# ─────────────────────────────────────────────
# VARIABLES DE ENTORNO — datos sensibles
# ─────────────────────────────────────────────
# Archivos .env contienen claves de API, contraseñas de base de datos
# y otros secretos. NUNCA deben subirse a un repositorio público.
.env
.env.local
.env.development
.env.production

# ─────────────────────────────────────────────
# LIQUIBASE — configuración local y credenciales
# ─────────────────────────────────────────────
# liquibase.properties contiene la URL de conexión,
# usuario y contraseña de la base de datos.
# No debe subirse al repositorio.
liquibase.properties

# ─────────────────────────────────────────────
# SISTEMA OPERATIVO — archivos basura del SO
# ─────────────────────────────────────────────
# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store
.AppleDouble

# ─────────────────────────────────────────────
# CLAUDE CODE — configuración local del agente
# ─────────────────────────────────────────────
# .claude/ contiene caché y sesiones locales de Claude Code.
# .agents/ contiene skills descargadas localmente.
# skills-lock.json registra hashes de skills instaladas.
# Ninguno es parte del proyecto compartido.
# CLAUDE.md contiene instrucciones del agente — no es parte del proyecto compartido.
.claude/
.agents/
skills-lock.json
CLAUDE.md

# ─────────────────────────────────────────────
# IMÁGENES / ARCHIVOS GENERADOS LOCALMENTE
# ─────────────────────────────────────────────
# Capturas de pantalla y previsualizaciones generadas en local.
signia_preview.png

# ─────────────────────────────────────────────
# EDITORES — configuración local del editor
# ─────────────────────────────────────────────
# Configuración personal de VS Code (excepto tareas compartidas)
.vscode/settings.json
.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/

# ─────────────────────────────────────────────
# LOGS — archivos de registro de errores
# ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────
# REACT NATIVE / EXPO — archivos nativos generados
# ─────────────────────────────────────────────
# Carpetas nativas generadas por Expo/EAS Build. Se regeneran
# automáticamente; no forman parte del código fuente.
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Caché de Metro bundler (React Native)
.metro-health-check*

# Caché de react-native-webview y otros módulos nativos
DesarrolloAplicativo/src/android/
DesarrolloAplicativo/src/ios/

# ─────────────────────────────────────────────
# BUILD / COMPILADOS — archivos generados
# ─────────────────────────────────────────────
# Resultado de compilar TypeScript. Se regeneran con "tsc".
build/
*.js.map

# Backend Node.js
DesarrolloAplicativo/backend/dist/
